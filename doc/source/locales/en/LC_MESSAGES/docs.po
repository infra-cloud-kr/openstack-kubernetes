msgstr ""

#: ../../source/foundations/openstack-fundamentals.rst:27
msgid "컴퓨팅 리소스의 인벤토리(inventory)와 할당 정보를 추적하여 Nova 스케줄러가 적절한 호스트를 선택할 수 있도록 지원"
msgstr ""

